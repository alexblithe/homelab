repositories:
  - name: traefik
    url: "https://traefik.github.io/charts"
  - name: tailscale
    url: "https://pkgs.tailscale.com/helmcharts"
  - name: cert-manager
    url: "https://charts.jetstack.io"
  - name: rancher
    url: "https://releases.rancher.com/server-charts/stable"
---

environments: 
  luna:
    secrets:
      - environments/luna/secrets.yaml
    values:
      - rancher:
          hostname: rancher.tailca3979.ts.net
          replicas: 1
          ingress:
            enabled: true
            extraAnnotations:
              tailscale.com/proxy-group: ingress-proxies
            ingressClassName: tailscale
  localhost:
    secrets:
      - environments/localhost/secrets.yaml
    values:
      - rancher:
          hostname: rancher.localhost
          replicas: 1
          ingress:
            enabled: true


---



releases:
  - name: tailscale
    namespace: tailscale
    version: "v1.98.4"
    chart: tailscale/tailscale-operator
    createNamespace: true
    values:
      - oauth:
          clientId: {{ .Values.tailscaleClientId | quote }}
          clientSecret: {{ .Values.tailscaleClientSecret | quote }}
    wait: true
  - name: tailscale-proxy-group
    namespace: tailscale
    chart: charts/tailscale-proxy-group
    wait: true
  - name: cert-manager
    namespace: cert-manager
    chart: jetstack/cert-manager
    version: "v1.20.2"
    createNamespace: true
    values:
      - installCRDs: true
    wait: true
  - name: rancher
    namespace: cattle-system
    chart: rancher/rancher
    version: "v2.14.2"
    createNamespace: true
    values:
      - bootstrapPassword: {{ .Values.rancherBootstrapPassword | quote }}
        hostname: {{ .Values.rancher.hostname | quote }}
        replicas: {{ .Values.rancher.replicas }}
        ingress:
          enabled: {{ .Values.rancher.ingress.enabled }}
          extraAnnotations: {{ .Values.rancher.ingress.extraAnnotations | toYaml | nindent 12 }}
          ingressClassName: {{ .Values.rancher.ingress.ingressClassName | quote }}

